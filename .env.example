# orbyn.dev on one Docker host. Copy to .env and fill in.

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token.
# Its public hostname orbyn.dev should point at http://web:8080 (the old route,
# http://gateway:8081, also works).
CLOUDFLARE_TUNNEL_TOKEN=

# Where the site is public. deploy.sh prints it when it is done.
APP_URL=https://orbyn.dev

# Optional: the local port for checks (published on 127.0.0.1 only).
# WEB_PORT=8080
