POSTGRES_USER=orbyn
POSTGRES_PASSWORD=orbyn-local-change-me
POSTGRES_DB=orbyn
DATABASE_URL=postgres://orbyn:orbyn-local-change-me@localhost:5433/orbyn
# The test suite uses only this, never DATABASE_URL. Start the test database with
#   docker compose --profile test up -d postgres-test
TEST_DATABASE_URL=postgres://orbyn:orbyn-test@localhost:55434/orbyn_test
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PORT=8000
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=Orbyn <reminders@orbyn.local>
EXPO_ACCESS_TOKEN=
# Comma-separated emails that are always system admins (the first account to register is also an admin).
ADMIN_EMAILS=
# Encrypts AI provider credentials saved from the admin console. Generate with:
#   openssl rand -base64 32
# Keep it secret and stable: changing it makes saved credentials unreadable.
SECRETS_KEY=

POSTGRES_PORT=5433
API_PORT=8008
WEB_PORT=8080
