POSTGRES_USER=orbyn
POSTGRES_PASSWORD=orbyn-local-change-me
POSTGRES_DB=orbyn
DATABASE_URL=postgres://orbyn:orbyn-local-change-me@localhost:5433/orbyn
# The test suite uses only this, never DATABASE_URL. Start the test database with
#   docker compose --profile test up -d postgres-test
TEST_DATABASE_URL=postgres://orbyn:orbyn-test@localhost:55434/orbyn_test
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PORT=8000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=Orbyn <reminders@orbyn.local>
EXPO_ACCESS_TOKEN=
# Comma-separated emails that are always system admins (the first account to register is also an admin).
ADMIN_EMAILS=
# AI providers are added by admins in the app (Admin -> AI), not here.
# Optional: 32 random bytes, base64 (openssl rand -base64 32). Encrypts saved
# provider keys outside the database; without it, Orbyn keeps a generated key
# in the database. Keep it stable once set.
SECRETS_KEY=

POSTGRES_PORT=5433
API_PORT=8008
WEB_PORT=8080
# Which host address the API port listens on; 127.0.0.1 keeps it off the
# network (the tunnel and the web port reach it inside Docker).
# API_BIND=127.0.0.1
# Host port of the test database (docker compose --profile test).
# TEST_POSTGRES_PORT=55434

# --- Errors on screen ---
# People always see plain messages ("Couldn't reach Orbyn…"); the details of a
# failed request (the call, status, what the server said, its request id) go to
# the browser console and the server log. true also shows those details on
# screen and in API replies: for development and test servers, never for the
# public. The web app picks it up when its image is built.
DEBUG_ERRORS=false

# --- Deploys and updates (see docs/deployment.md) ---
# Install or update a server with ./scripts/deploy.sh (--check to preview).
# Database dumps it takes before each migration are kept in backups/.
# BACKUP_KEEP=7
# Copies per service; scripts/deploy.sh replaces them one set at a time.
# API_REPLICAS=2
# AI_REPLICAS=2
# Isolated background and overnight consumers (never combine them in ai/notifier).
# ASSISTANT_BACKGROUND_REPLICAS=1
# ASSISTANT_OVERNIGHT_REPLICAS=1
AI_RUNNER_IN_WORKER=false
# The realtime service holds every live stream (live updates, presence, live
# documents); scale it with open connections, not requests.
# REALTIME_REPLICAS=2
# The mcp service answers outside AI agents (short, stateless calls).
# MCP_REPLICAS=2
# WEB_REPLICAS=2
# STATUS_REPLICAS=1
# NOTIFIER_REPLICAS=1
# Update checks in Admin -> System: "owner/repo" on GitHub (and a read-only
# token for a private repository).
# UPDATE_REPO=kinqsradiollc/Orbyn
# UPDATE_BRANCH=main
# GITHUB_TOKEN=
# Where Admin -> System's "Deploy" button leads; the repo's deploy workflow
# when empty.
# DEPLOY_URL=

# --- Booking pages and webhooks ---
# Where people open the web app. Every link Orbyn emails (booking
# confirmations, manage and cancel links, invitations, RSVP) is built from it,
# so set it to the address you actually open: the Compose stack's web port by
# default, your Vite port when running the web app outside Docker, or your
# public address in production.
# APP_URL=http://localhost:8080
# Opening the web app's /app/ links in the phone app (universal links, app
# links): the Apple team that signs the iOS app, and the SHA-256 fingerprints
# (comma separated) of the certificates that sign the Android app. Blank
# serves empty /.well-known/ files, so links stay in the browser.
# APPLE_TEAM_ID=
# ANDROID_CERT_FINGERPRINTS=
# Lets webhooks call private network addresses. Local development only: in
# production webhooks must reach public addresses.
# ALLOW_PRIVATE_WEBHOOKS=false

# --- Scaling (optional; see docs/scalability.md) ---
# Read replica for lag-tolerant reads. Local dev: a direct replica URL.
# DATABASE_READ_URL=
# A direct line to the primary for LISTEN/NOTIFY — live updates, presence and
# live documents on the realtime service. PgBouncer in transaction pooling
# cannot hold a LISTEN open, so set this wherever DATABASE_URL points at
# PgBouncer. Empty means DATABASE_URL is already direct. Compose builds it for
# you from POSTGRES_*; set it only when running services outside Compose.
# DATABASE_LISTEN_URL=postgres://orbyn:orbyn-local-change-me@postgres:5432/orbyn

# Host port of the streaming replica (docker compose --profile replica).
# REPLICA_PORT=5434
# Docker: PgBouncer's read route, enabled by PGBOUNCER_READ_HOST.
# DOCKER_DATABASE_READ_URL=postgres://orbyn:orbyn-local-change-me@pgbouncer:6432/orbyn_read
# PGBOUNCER_READ_HOST=postgres-replica
# Connections each service instance keeps (instances x this <= PgBouncer max_client_conn).
# DB_POOL_MAX=20
# Per-instance limit; 0 leaves limiting to the gateway.
# SERVICE_RATE_LIMIT_PER_MINUTE=1200
# Outside Compose (npm run dev:api): requests per minute per client, and
# whether to trust X-Forwarded-For. Compose sets both from the lines above.
# RATE_LIMIT_PER_MINUTE=180
# TRUST_PROXY=false
# Parallel delivery lanes in the reminder service.
# NOTIFIER_CONCURRENCY=4
# How often the status page probes each service, in milliseconds.
# STATUS_INTERVAL_MS=30000
# Share of ordinary requests kept in Admin -> Requests (0-1). Errors and
# requests over a second are always kept; daily counts include everything.
# REQUEST_LOG_SAMPLE=1
# Gateway targets, "host:port ..." per service, for services on other machines.
# GATEWAY_WEB_SERVERS=desktop:8080
# GATEWAY_API_SERVERS=api:8000
# GATEWAY_AI_SERVERS=ai:8000
# GATEWAY_REALTIME_SERVERS=realtime:8000
# GATEWAY_STATUS_SERVERS=status:8000
# GATEWAY_MCP_SERVERS=mcp:8000
# GATEWAY_RESOLVER=127.0.0.11
# Load balancer address ranges in front of the gateway, for real client IPs.
# GATEWAY_TRUSTED_PROXIES=
# Address ranges never rate limited; leave empty in production.
# GATEWAY_RATE_LIMIT_EXEMPT=127.0.0.1/32 192.168.65.0/24

# --- Your own mail server (optional; see docs/deployment.md) ---
# Sends Orbyn's mail itself, signed with DKIM, instead of using a provider.
# Local-only testing: ./scripts/mail-local.sh up (no Tunnel or public delivery).
# Production: docker compose up -d --wait mail, then scripts/deploy.sh --no-pull.
# Then point Orbyn at it: DOCKER_SMTP_HOST=mail and SMTP_PORT=587.
# The SMTP host the Docker services use (mailpit catches mail locally).
# DOCKER_SMTP_HOST=mailpit
# The name it introduces itself as; needs an A record and matching reverse DNS.
# MAIL_HOSTNAME=mail.your-domain
# The domain it may send for, and the domain DKIM signs.
# MAIL_DOMAIN=your-domain
# Delivering straight to recipients needs outbound port 25. Where that is
# blocked, hand the last hop to another server instead:
# MAIL_CONFIG=maddy-relay.conf
# MAIL_RELAY=tcp://smtp.your-provider.com:587
# MAIL_RELAY_USER=
# MAIL_RELAY_PASSWORD=
# Pin the mail server image instead of following this release.
# MADDY_IMAGE=foxcpp/maddy:0.9.5
# Email to task (see docs/deployment.md, "Email to task"): people get a private
# <slug>@<domain> address and mail they send to it becomes a task. Off until
# the secret is set.
# MAIL_INBOUND_DOMAIN=tasks.your-domain
# MAIL_INBOUND_SECRET=

# Optional services this machine runs, so plain `docker compose up -d` includes
# them: tunnel (Cloudflare), mail (your own outbound mail server), formula
# (equations on imported scans, ~1-2 GB) and ocr (the heavy OCR model, ~16 GB;
# leave it out unless the server has the memory).
# COMPOSE_PROFILES=tunnel,mail

# --- Public access through a Cloudflare tunnel (optional; see docs/deployment.md) ---
# The token of the tunnel you created in Cloudflare (Zero Trust -> Networks ->
# Tunnels). Keep it secret: it lets anyone run this tunnel. Then start it with
#   docker compose --profile tunnel up -d
# In Cloudflare, point the tunnel's public hostname at http://gateway:8081 —
# the web app, with the API under /api.
# CLOUDFLARE_TUNNEL_TOKEN=
# Pin a cloudflared release instead of following the latest image.
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
# With the app public, also set APP_URL and CORS_ORIGINS to the public address
# (https://your-domain), and set GATEWAY_TRUSTED_PROXIES to the Docker network
# range (for example 172.16.0.0/12) so rate limits see real client addresses.

# --- Importing PDF and Word files into Docs (see docs/deployment.md) ---
# Signs upload links; shared by api, files and converter. Blank turns
# importing off. Make one with: openssl rand -base64 32
# FILES_SECRET=
# Encrypts each stored upload's own key (files service only). 32 bytes,
# base64: openssl rand -base64 32. Uploads never outlive a day.
# FILES_MASTER_KEY=
# Where the file store keeps uploads outside Compose (Compose uses a volume).
# FILES_DIR=
# Where the converter reaches the file store outside Compose.
# FILES_URL=http://localhost:8000
# Uploads are refused when less than this much disk (MB) would be left.
# FILES_MIN_FREE_MB=1024
# "Keep the original": space per person (MB) for imported files kept after
# they become pages, in FILES_DIR/kept (back that folder up).
# FILES_KEEP_QUOTA_MB=500
# Search by meaning needs pgvector: use this image for postgres (Compose),
# then the `semantic` profile's measure service, then set it up in Admin → AI.
# POSTGRES_IMAGE=pgvector/pgvector:pg17
# Pictures and files in pages are kept by the same file store, for as long as
# their page, on a volume of their own (Compose: page_files; back it up with
# the database). Outside Compose, where to keep them (blank: FILES_DIR/pages):
# PAGE_FILES_DIR=
# Space per person for pictures and files in pages (MB), and the largest file.
# PAGE_FILES_QUOTA_MB=1024
# PAGE_FILES_MAX_MB=25
# The model that writes out recordings made in pages (CAP-10), on the
# assistant's own provider (its /audio/transcriptions). The ai service reads
# recordings from the file store, so it needs FILES_URL and FILES_SECRET too.
# AI_TRANSCRIBE_MODEL=whisper-1
# Scanned pages and photos are read with Tesseract, built into the backend
# image (English). Pages read at once:
# TESSERACT_WORKERS=2
# Equations on scanned pages (the formula profile, pix2tex, about 1-2 GB):
# add `formula` to COMPOSE_PROFILES and set
# FORMULA_URL=http://formula:8000
# FORMULA_MEMORY=2g
# The heavy OCR model (the ocr profile, about 16 GB of RAM), off by default:
# it replaces Tesseract for scans on big servers. With the profile on, set
# OCR_URL=http://ocr:8000.
# OCR_URL=
# OCR pages read at once: one per ocr container (docker compose up -d --scale ocr=2).
# OCR_WORKERS=1
# Longest one page may take on CPU before it's retried.
# OCR_TIMEOUT_MS=600000
# Caps for each ocr container, so it can't starve Postgres and the API.
# OCR_MEMORY=16g
# OCR_CPUS=8
# gundam crops dense pages (better); base is faster.
# OCR_IMAGE_MODE=gundam
# Pin the model and its code to a reviewed Hugging Face commit.
# OCR_MODEL_REVISION=main
# 1 once the model has downloaded: the ocr container never reaches the internet.
# OCR_OFFLINE=0

# --- Outside AI agents (MCP) ---
# The MCP address agents connect to: shown in Settings -> Connected agents and
# named in every sign-in challenge. Set it here; it is never read from request
# headers. Point the tunnel's mcp.orbyn.dev hostname at the gateway's port
# 8082 (http://gateway:8082).
# MCP_PUBLIC_URL=https://mcp.orbyn.dev/mcp
# Separate plugin recipient. Leave blank until plugin execution/UI and OAuth
# acceptance are delivered. The standalone plugin service is disabled by default.
# PLUGIN_PUBLIC_URL=
# Who issues agent sign-ins (OAuth, phase A2); empty uses APP_URL.
# OAUTH_ISSUER=
# Seconds an agent access token lasts, and days an unused refresh token lasts.
# OAUTH_ACCESS_TTL=3600
# OAUTH_REFRESH_TTL=30
# The gateway's MCP host port on this machine (local testing).
# MCP_BIND=127.0.0.1
# MCP_PORT=8009
# 1 makes the gateway answer every MCP request with 503 (restarts the gateway;
# Admin's "agents on" switch needs no restart).
# MCP_DISABLED=
# Where security problems are reported: the Contact line of
# /.well-known/security.txt (mailto: or https:).
# SECURITY_CONTACT=mailto:hello@orbyn.dev
# The OpenAI apps directory's domain check: the token it gives, answered at
# /.well-known/openai-apps-challenge on the MCP host (empty: 404).
# OPENAI_APPS_CHALLENGE=
# Where the status page probes the mcp service (Compose sets it).
# STATUS_MCP_URL=

# Independent shared key between API and the private PDF renderer (openssl rand -hex 32).
DOC_PDF_KEY=
# Native/local API only; Compose uses http://pdf:8000.
DOC_PDF_URL=
DOC_PDF_CONCURRENCY=2
# Renderer only; Chromium sandbox remains enabled.
DOC_PDF_EXECUTABLE=/usr/bin/chromium
