{
  "schema_version": 1,
  "processing": {
    "codex_service_tier": "default",
    "codex_fast_mode": false,
    "codex_ultrafast_mode": false,
    "claude_fast_mode": false,
    "claude_disable_fast_mode": "1"
  },
  "defaults": {
    "codex": "orbyn-agent",
    "claude": "orbyn-agent"
  },
  "agents": {
    "orbyn-agent": {
      "purpose": "Complex planning, implementation, diagnosis and review",
      "codex": { "model": "gpt-6.1-sol", "effort": "medium" },
      "claude": { "model": "opus", "effort": "medium" }
    },
    "orbyn-light": {
      "purpose": "Bounded lookup, small edits, documentation and authorized checks",
      "codex": { "model": "gpt-6-luna", "effort": "high" },
      "claude": { "model": "sonnet", "effort": "medium" }
    }
  },
  "human_only": {
    "codex": { "model": "gpt-6-astra" },
    "claude": { "model": "fable" }
  }
}
