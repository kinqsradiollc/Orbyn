# The API's address. On a physical device in development, use your computer's
# LAN address (http://192.168.x.x:8008). Production must use HTTPS.
# Behind the gateway or a Cloudflare tunnel the API sits under /api on the same
# hostname as the web app, so use https://your-domain/api.
EXPO_PUBLIC_API_URL=http://localhost:8008
# Your Expo project id, for push notifications (from `eas init` or the project's
# settings in the Expo dashboard). Empty turns push registration off.
EXPO_PUBLIC_EAS_PROJECT_ID=
