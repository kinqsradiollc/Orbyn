{
  "expo": {
    "name": "Orbyn",
    "slug": "orbyn",
    "scheme": "orbyn",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orbyn.planner",
      "requireFullScreen": false
    },
    "android": {
      "package": "com.orbyn.planner",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsFileWithMaxCount": 5,
              "supportsImageWithMaxCount": 5,
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain",
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "image/png",
              "image/jpeg"
            ],
            "multipleShareMimeTypes": [
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "image/png",
              "image/jpeg"
            ]
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Orbyn uses the camera to scan your notes into a page.",
          "photosPermission": "Orbyn reads a photo of your notes you choose, to turn it into a page."
        }
      ],
      "./modules/orbyn-quick-actions/app.plugin.js"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "backgroundColor": "#f7f8fa"
  }
}
