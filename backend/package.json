    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "zod": "^4.3.6",
    "@orbyn/core": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
