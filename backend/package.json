{
  "name": "@orbyn/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/services/api.js",
    "worker": "node dist/services/notifier.js",
    "migrate": "tsx src/migrate.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "admin:grant": "tsx src/grant-admin.ts",
    "smoke": "tsx scripts/smoke.ts",
    "dev:api": "tsx watch src/services/api.ts",
    "dev:ai": "tsx watch src/services/ai.ts",
    "dev:status": "tsx watch src/services/status.ts",
    "dev:notifier": "tsx watch src/services/notifier.ts",
    "dev:converter": "tsx watch src/services/converter.ts",
    "dev:mcp": "tsx watch src/services/mcp.ts",
    "start:ai": "node dist/services/ai.js",
    "start:status": "node dist/services/status.js",
    "start:notifier": "node dist/services/notifier.js",
    "start:files": "node dist/services/files.js",
    "start:converter": "node dist/services/converter.js",
    "start:mcp": "node dist/services/mcp.js",
    "start:all": "node dist/server.js",
    "load": "tsx scripts/load.ts",
    "mcp:catalog": "tsx scripts/mcp-catalog.ts",
    "directory:account": "tsx scripts/directory-account.ts",
    "gameday": "tsx scripts/gameday.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@orbyn/core": "1.0.0",
    "@simplewebauthn/server": "^13.3.3",
    "argon2": "^0.44.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.12.4",
    "katex": "^0.16.47",
    "nodemailer": "^10.0.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.23.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@orbyn/api-client": "1.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
