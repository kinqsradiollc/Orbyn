# API gateway template, rendered by entrypoint.sh from environment variables so
# the same file works on one Docker host or with services spread across
# machines. Routes each path to the service that owns it; keep in step with
# serviceModules in backend/src/app.ts. ${NAME} placeholders are filled in at
# start; nginx's own $variables are left alone.

worker_processes auto;
worker_rlimit_nofile 65535;
pid /tmp/nginx.pid;

events {
  worker_connections 8192;
  multi_accept on;
}

http {
  # Writable paths for the unprivileged image.
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;

  default_type application/json;
  server_tokens off;
  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout 65s;
  keepalive_requests 10000;
  access_log /dev/stdout combined buffer=64k flush=5s;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types application/json text/plain;
  gzip_vary on;

  # DNS used to re-resolve service names, so scaling or restarting a service
  # never needs a gateway restart. Docker's DNS by default (GATEWAY_RESOLVER).
  resolver ${RESOLVER} valid=10s ipv6=off;

  # Real client addresses when a load balancer sits in front (GATEWAY_TRUSTED_PROXIES).
  # After this, $remote_addr is the visitor: the connecting address, or the
  # address a trusted proxy in front says it saw. Only that one address is
  # passed on (X-Forwarded-For $remote_addr below), never the header as it
  # arrived: the services trust X-Forwarded-For, so appending to a header a
  # client wrote would let anyone pick the address their rate limits count
  # against, sign-in's included.
${REAL_IP}

  # Per-client limits. Addresses in GATEWAY_RATE_LIMIT_EXEMPT (by default
  # loopback and Docker Desktop's host network, for local load tests) are not
  # limited. In production leave it empty and set GATEWAY_TRUSTED_PROXIES.
  geo $limit_key {
    default $binary_remote_addr;
${LIMIT_EXEMPT}
  }
  limit_req_zone $limit_key zone=per_client:20m rate=50r/s;
  limit_conn_zone $limit_key zone=conn_per_client:10m;
  limit_req_status 429;
  limit_conn_status 429;

  # Outside agents (MCP) are limited per credential, never per address: the
  # key is the Authorization header itself (nginx keeps keys in shared
  # memory). Calls in flight are capped per credential across every mcp copy
  # here; per-minute and daily limits are also counted by the service.
  limit_req_zone $http_authorization zone=mcp_token:20m rate=120r/m;
  limit_conn_zone $http_authorization zone=mcp_conn:10m;

  # Micro-cache for the public status report.
  proxy_cache_path /tmp/status_cache levels=1 keys_zone=status_cache:1m max_size=10m inactive=1m use_temp_path=off;

  # Load-balanced, keep-alive connections to every instance of each service.
  # Server lists come from GATEWAY_API_SERVERS and friends ("host:port ...").
  upstream api {
    zone api 64k;
    least_conn;
${UPSTREAM_API}
    keepalive 128;
  }
  upstream ai {
    zone ai 64k;
    least_conn;
${UPSTREAM_AI}
    keepalive 32;
  }
  # The web app's static files (desktop image); several copies roll over
  # without downtime because only the gateway holds host ports.
  upstream web {
    zone web 64k;
    least_conn;
${UPSTREAM_WEB}
    keepalive 32;
  }
  # Long-lived streams: live news and live documents. Few requests, many
  # open connections, so its own pool and its own replicas.
  upstream realtime {
    zone realtime 64k;
    least_conn;
${UPSTREAM_REALTIME}
    keepalive 32;
  }
  upstream status {
    zone status 64k;
${UPSTREAM_STATUS}
    keepalive 16;
  }
  # The file store: uploads for importing into Docs. Only its upload route
  # is exposed here; reading a file back is for the converter alone.
  upstream files {
    zone files 64k;
    least_conn;
${UPSTREAM_FILES}
    keepalive 16;
  }

  # The MCP service: stateless calls from outside agents.
  upstream mcp {
    zone mcp 64k;
    least_conn;
${UPSTREAM_MCP}
    keepalive 64;
  }

  # The scheme the browser used: kept from a TLS proxy in front, else our own.
  map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
  }

  server {
    listen 8080;
    client_max_body_size 64k;
    limit_conn conn_per_client 200;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # The visitor's address alone, replacing whatever the client sent.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Request-Id $request_id;
    # Internal connections take milliseconds; a short connect timeout means a
    # copy that just stopped costs about a second before the next one is tried.
    proxy_connect_timeout 1s;
    proxy_read_timeout 125s;
    # Retry another replica only for idempotent requests (nginx's default).
    proxy_next_upstream error timeout http_502 http_503;
    # While old and new copies overlap during a deploy, try up to four within
    # 5 seconds so a request never lands on two stopped copies in a row.
    proxy_next_upstream_tries 4;
    proxy_next_upstream_timeout 5s;

    location = /health {
      access_log off;
      return 200 '{"status":"ok","service":"gateway"}';
    }

    # AI assistant service.
    location /ai/ {
      limit_req zone=per_client burst=40 nodelay;
      proxy_pass http://ai;
    }

    # Realtime service: the apps' event stream and live documents. Streams
    # stay open (the service closes each after 15 minutes, and the apps
    # reconnect), so nothing is buffered and the read timeout is long.
    location /events {
      limit_conn conn_per_client 20;
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 1h;
      proxy_pass http://realtime;
    }
    location ~ ^/docs/[^/]+/live$ {
      limit_conn conn_per_client 40;
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 1h;
      proxy_pass http://realtime;
    }

    # Public status report, cached for 10 seconds.
    location = /status {
      proxy_cache status_cache;
      proxy_cache_valid 200 10s;
      proxy_cache_lock on;
      proxy_cache_use_stale error timeout updating http_500 http_502 http_503;
      add_header X-Cache-Status $upstream_cache_status always;
      proxy_pass http://status;
    }

    # Uploads for importing into Docs go straight to the file store,
    # streamed (not buffered here) and up to 50 MB. The link in the path is
    # signed by the API and works once.
    location /files/u/ {
      limit_req zone=per_client burst=10 nodelay;
      client_max_body_size 52m;
      proxy_request_buffering off;
      proxy_read_timeout 600s;
      proxy_send_timeout 600s;
      proxy_next_upstream off;
      proxy_pass http://files;
    }

    # The MCP address for older setups (the web app's /api/mcp): the mcp
    # service, as on mcp.orbyn.dev.
    location = /mcp {
      ${MCP_GATE}
      limit_req zone=per_client burst=100 nodelay;
      limit_req zone=mcp_token burst=60 nodelay;
      limit_conn mcp_conn 8;
      proxy_buffering off;
      proxy_read_timeout 100s;
      proxy_next_upstream off;
      proxy_pass http://mcp;
      error_page 429 = @mcp_limited;
    }
    location @mcp_limited {
      add_header Retry-After 30 always;
      return 429 '{"jsonrpc":"2.0","id":null,"error":{"code":-32029,"message":"That\'s a lot at once. Wait a moment and try again."}}';
    }

    # Everything else: the planner API.
    location / {
      limit_req zone=per_client burst=100 nodelay;
      proxy_pass http://api;
    }

    error_page 502 503 504 = @unavailable;
    location @unavailable {
      return 503 '{"message":"Orbyn is briefly unavailable. Please try again."}';
    }
  }

  # The web port: the app's pages from the web copies, and /api through this
  # gateway's own API entry point above (so routing and limits are shared).
  server {
    listen 8081;
    client_max_body_size 64k;
    limit_conn conn_per_client 200;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Request-Id $request_id;
    proxy_connect_timeout 1s;
    proxy_read_timeout 125s;
    proxy_next_upstream error timeout http_502 http_503;
    proxy_next_upstream_tries 4;
    proxy_next_upstream_timeout 5s;

    location = /health {
      access_log off;
      return 200 '{"status":"ok","service":"gateway"}';
    }

    location /api/ {
      # A proxy_set_header here replaces the server's, so all are restated.
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      # Links the API builds (the calendar feed) need the /api it sits under.
      proxy_set_header X-Forwarded-Prefix /api;
      proxy_pass http://127.0.0.1:8080/;
    }

    # Uploads for importing, through this gateway's own entry point above.
    location /api/files/u/ {
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      client_max_body_size 52m;
      proxy_request_buffering off;
      proxy_read_timeout 600s;
      proxy_send_timeout 600s;
      proxy_pass http://127.0.0.1:8080/files/u/;
    }

    # CalDAV, served by the API at its own /dav path (no /api strip), so Apple
    # Calendar, Thunderbird and DAVx5 can subscribe and write events back.
    location /dav/ {
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_pass http://127.0.0.1:8080;
    }
    location = /.well-known/caldav {
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_pass http://127.0.0.1:8080;
    }
    # Signing in with Orbyn: the authorization server's metadata (RFC 8414)
    # lives at the issuer (this host), served by the API. Its other endpoints
    # are under /api/oauth/ (the /api/ location above).
    location = /.well-known/oauth-authorization-server {
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_pass http://127.0.0.1:8080;
    }
    # Opening the web app's links in the phone app: the association files
    # iOS and Android check, built by the API from its environment.
    location = /.well-known/apple-app-site-association {
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_pass http://127.0.0.1:8080;
    }
    location = /.well-known/assetlinks.json {
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_pass http://127.0.0.1:8080;
    }
    # Any other well-known document isn't here: a 404, not the web app's page
    # (clients probe paths like /.well-known/openid-configuration).
    location ^~ /.well-known/ {
      default_type application/json;
      return 404 '{"message":"That isn\'t here."}';
    }

    location / {
      proxy_pass http://web;
    }

    error_page 502 503 504 = @unavailable;
    location @unavailable {
      return 503 '{"message":"Orbyn is briefly unavailable. Please try again."}';
    }
  }

  # The MCP host (mcp.orbyn.dev through the tunnel): only the MCP address and
  # its protected-resource metadata; everything else is a 404.
  server {
    listen 8082;
    client_max_body_size 1m;
    limit_conn conn_per_client 200;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Request-Id $request_id;
    proxy_connect_timeout 1s;
    proxy_read_timeout 100s;
    proxy_next_upstream error timeout http_502 http_503;
    proxy_next_upstream_tries 4;
    proxy_next_upstream_timeout 5s;

    location = /health {
      access_log off;
      return 200 '{"status":"ok","service":"gateway"}';
    }

    location = /mcp {
      ${MCP_GATE}
      # A high ceiling per address; the real limits are per credential.
      # Review in phase A2: hosted agents (claude.ai, ChatGPT) share their
      # providers' egress addresses, so raise this for those ranges (or
      # exempt them through LIMIT_EXEMPT) before they connect.
      limit_req zone=per_client burst=200 nodelay;
      limit_req zone=mcp_token burst=60 nodelay;
      limit_conn mcp_conn 8;
      proxy_buffering off;
      proxy_next_upstream off;
      proxy_pass http://mcp;
      error_page 429 = @mcp_limited;
    }
    location = /.well-known/oauth-protected-resource {
      proxy_pass http://mcp;
    }
    location = /.well-known/oauth-protected-resource/mcp {
      proxy_pass http://mcp;
    }
    location @mcp_limited {
      add_header Retry-After 30 always;
      return 429 '{"jsonrpc":"2.0","id":null,"error":{"code":-32029,"message":"That\'s a lot at once. Wait a moment and try again."}}';
    }
    location / {
      return 404 '{"message":"That isn\'t here. The MCP address is /mcp."}';
    }

    error_page 502 503 504 = @unavailable;
    location @unavailable {
      return 503 '{"jsonrpc":"2.0","id":null,"error":{"code":-32603,"message":"Orbyn is briefly unavailable. Please try again."}}';
    }
  }
}
