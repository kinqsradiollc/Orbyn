# API gateway template, rendered by entrypoint.sh from environment variables so
# the same file works on one Docker host or with services spread across
# machines. Routes each path to the service that owns it; keep in step with
# serviceModules in backend/src/app.ts. ${NAME} placeholders are filled in at
# start; nginx's own $variables are left alone.

worker_processes auto;
worker_rlimit_nofile 65535;
pid /tmp/nginx.pid;

events {
  worker_connections 8192;
  multi_accept on;
}

http {
  # Writable paths for the unprivileged image.
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;

  default_type application/json;
  server_tokens off;
  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout 65s;
  keepalive_requests 10000;
  access_log /dev/stdout combined buffer=64k flush=5s;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types application/json text/plain;
  gzip_vary on;

  # DNS used to re-resolve service names, so scaling or restarting a service
  # never needs a gateway restart. Docker's DNS by default (GATEWAY_RESOLVER).
  resolver ${RESOLVER} valid=10s ipv6=off;

  # Real client addresses when a load balancer sits in front (GATEWAY_TRUSTED_PROXIES).
  # After this, $remote_addr is the visitor: the connecting address, or the
  # address a trusted proxy in front says it saw. Only that one address is
  # passed on (X-Forwarded-For $remote_addr below), never the header as it
  # arrived: the services trust X-Forwarded-For, so appending to a header a
  # client wrote would let anyone pick the address their rate limits count
  # against, sign-in's included.
${REAL_IP}

  # Per-client limits. Addresses in GATEWAY_RATE_LIMIT_EXEMPT (by default
  # loopback and Docker Desktop's host network, for local load tests) are not
  # limited. In production leave it empty and set GATEWAY_TRUSTED_PROXIES.
  #
  # Shared-memory zones are process-wide, and the web port (8081) re-enters
  # the API port (8080) for /api, so a request passing both would be counted
  # once per zone at each hop — and a stream, which holds its connection
  # open, would eat three slots for its whole 15-minute cycle (web server
  # level, API server level, and the API location). To count every request
  # exactly once, where the visit starts, the web port marks what it forwards
  # (X-Orbyn-Via: web) and the zone keys below go empty for marked requests;
  # nginx never accounts a request whose key is empty. The API port answers
  # direct clients (the loopback API_BIND) unmarked and is counted there.
  # Tests keep this honest (see backend/tests/gateway-config.test.ts): every
  # limit in the API server must sit on a zone keyed through the marker, or
  # browser requests get counted twice.
  geo $limit_key {
    default $binary_remote_addr;
${LIMIT_EXEMPT}
  }
  # The visitor's address, unless the request was forwarded by our own web
  # port on its loopback hop to 8080 (already counted there). Neither a
  # client-supplied header on 8081 nor a remote request to 8080 can opt out.
  map "$server_port:$realip_remote_addr:$http_x_orbyn_via" $req_key {
    default $limit_key;
    "8080:127.0.0.1:web" "";
    "8080:::1:web" "";
  }
  map "$server_port:$realip_remote_addr:$http_x_orbyn_via" $sse_key {
    default $limit_key;
    "8080:127.0.0.1:web" "";
    "8080:::1:web" "";
  }
  limit_req_zone $req_key zone=per_client:20m rate=50r/s;
  limit_conn_zone $limit_key zone=conn_per_client:10m;
  # Event streams hold their connection open, so the ceiling is generous on
  # purpose: several devices and tabs behind one address (a household) each
  # hold one or a few streams for the full 15-minute cycle, and a deploy
  # reconnects them all at once.
  limit_conn_zone $sse_key zone=sse_per_client:10m;
  limit_req_status 429;
  limit_conn_status 429;

  # A limited request says when to come back, in the shape every Orbyn
  # client reads: a 429's Retry-After drives their backoff, and the JSON
  # body carries the same plain message every other error does. Without
  # this, nginx's stock HTML page has no Retry-After, and the apps fall
  # back to their slowest retry path. The @limited location and its
  # error_page are declared in each server that serves people (see the
  # @unavailable pattern there). Content-Type comes from default_type.

  # Outside agents (MCP) are limited per credential, never per address: the
  # key is the Authorization header itself (nginx keeps keys in shared
  # memory). Calls in flight are capped per credential across every mcp copy
  # here; per-minute and daily limits are also counted by the service.
  limit_req_zone $http_authorization zone=mcp_token:20m rate=120r/m;
  limit_conn_zone $http_authorization zone=mcp_conn:10m;

  # Micro-cache for the public status report.
  proxy_cache_path /tmp/status_cache levels=1 keys_zone=status_cache:1m max_size=10m inactive=1m use_temp_path=off;

  # Load-balanced, keep-alive connections to every instance of each service.
  # Server lists come from GATEWAY_API_SERVERS and friends ("host:port ...").
  upstream api {
    zone api 64k;
    least_conn;
${UPSTREAM_API}
    keepalive 128;
  }
  upstream ai {
    zone ai 64k;
    least_conn;
${UPSTREAM_AI}
    keepalive 32;
  }
  # The web app's static files (desktop image); several copies roll over
  # without downtime because only the gateway holds host ports.
  upstream web {
    zone web 64k;
    least_conn;
${UPSTREAM_WEB}
    keepalive 32;
  }
  # Long-lived streams: live news and live documents. Few requests, many
  # open connections, so its own pool and its own replicas.
  upstream realtime {
    zone realtime 64k;
    least_conn;
${UPSTREAM_REALTIME}
    keepalive 32;
  }
  upstream status {
    zone status 64k;
${UPSTREAM_STATUS}
    keepalive 16;
  }
  # The file store: uploads for importing into Docs. Only its upload route
  # is exposed here; reading a file back is for the converter alone.
  upstream files {
    zone files 64k;
    least_conn;
${UPSTREAM_FILES}
    keepalive 16;
  }

  # The MCP service: stateless calls from outside agents.
  upstream mcp {
    zone mcp 64k;
    least_conn;
${UPSTREAM_MCP}
    keepalive 64;
  }

  # Agents following Orbyn (MCP subscriptions/listen) hold a stream open, so
  # those requests go to the realtime service, never the stateless mcp
  # copies: the method is in the Mcp-Method header (MCP 2026-07-28).
  map $http_mcp_method $mcp_listen {
    default 0;
    "subscriptions/listen" 1;
  }

  # The scheme the browser used: kept from a TLS proxy in front, else our own.
  map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
  }

  # The API server: reached directly by API clients (the loopback API_BIND)
  # and, with /api stripped, by the web port above. Every limit here sits on
  # a zone whose key goes empty for requests the web port forwarded, so a
  # browser request is counted once (there) and a direct request once (here).
  # No server-level limit_conn: it would apply to every location including
  # the forwarded pass-through, which the web port has already counted.
  server {
    listen 8080;
    client_max_body_size 64k;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # The visitor's address alone, replacing whatever the client sent.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Request-Id $request_id;
    # Internal connections take milliseconds; a short connect timeout means a
    # copy that just stopped costs about a second before the next one is tried.
    proxy_connect_timeout 1s;
    proxy_read_timeout 125s;
    # Retry another replica only for idempotent requests (nginx's default).
    proxy_next_upstream error timeout http_502 http_503;
    # While old and new copies overlap during a deploy, try up to four within
    # 5 seconds so a request never lands on two stopped copies in a row.
    proxy_next_upstream_tries 4;
    proxy_next_upstream_timeout 5s;

    location = /health {
      access_log off;
      return 200 '{"status":"ok","service":"gateway"}';
    }

    # AI assistant service (direct API clients only; the app's /api/ai
    # arrives through the web port below).
    location /ai/ {
      limit_req zone=per_client burst=40 nodelay;
      proxy_pass http://ai;
    }

    # OAuth codes/state are private; neither access nor upstream error logs
    # may record this query. A mutating code exchange is never proxy-retried.
    location = /agent-channels/slack/callback {
      access_log off;
      error_log /dev/null crit;
      proxy_next_upstream off;
      limit_req zone=per_client burst=40 nodelay;
      proxy_pass http://api;
    }

    location = /agent-channels/teams/callback {
      access_log off;
      error_log /dev/null crit;
      proxy_next_upstream off;
      limit_req zone=per_client burst=40 nodelay;
      proxy_pass http://api;
    }

    location = /agent-channels/teams/activities {
      access_log off;
      error_log /dev/null crit;
      proxy_next_upstream off;
      limit_req zone=per_client burst=40 nodelay;
      proxy_pass http://api;
    }

    location = /agent-channels/slack/events {
      access_log off;
      error_log /dev/null crit;
      proxy_next_upstream off;
      limit_req zone=per_client burst=40 nodelay;
      proxy_pass http://api;
    }

    location = /agent-channels/slack/interactions {
      access_log off;
      error_log /dev/null crit;
      proxy_next_upstream off;
      limit_req zone=per_client burst=40 nodelay;
      proxy_pass http://api;
    }

    # Realtime service: the apps' event stream and live documents. Streams
    # stay open (the service closes each after 15 minutes, and the apps
    # reconnect), so nothing is buffered and the read timeout is long. For
    # direct clients these connections are counted here (sse_per_client);
    # requests forwarded by the web port have an empty key and skip it —
    # the web port counted them already.

    # Realtime service: the apps' event stream and live documents. Streams
    # stay open (the service closes each after 15 minutes, and the apps
    # reconnect), so nothing is buffered and the read timeout is long. The
    # connection ceiling is per address and generous on purpose: several
    # devices and tabs behind one address (a household) each hold one or a
    # few streams for the full 15-minute cycle, and a deploy reconnects
    # them all at once.
    location /events {
      limit_conn sse_per_client 100;
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 1h;
      proxy_pass http://realtime;
    }
    location ~ ^/docs/[^/]+/live$ {
      limit_conn sse_per_client 100;
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 1h;
      proxy_pass http://realtime;
    }

    # Public status report, cached for 10 seconds.
    location = /status {
      proxy_cache status_cache;
      proxy_cache_valid 200 10s;
      proxy_cache_lock on;
      proxy_cache_use_stale error timeout updating http_500 http_502 http_503;
      add_header X-Cache-Status $upstream_cache_status always;
      proxy_pass http://status;
    }

    # Uploads for importing into Docs go straight to the file store,
    # streamed (not buffered here) and up to 50 MB. The link in the path is
    # signed by the API and works once.
    # Markdown and Notion exports into pages (DATA-08): a zip up to 20 MB,
    # sent as base64 in one JSON request.
    location = /imports/pages {
      limit_req zone=per_client burst=20 nodelay;
      client_max_body_size 28m;
      proxy_read_timeout 125s;
      proxy_pass http://api;
    }
    location /files/u/ {
      limit_req zone=per_client burst=10 nodelay;
      client_max_body_size 52m;
      proxy_request_buffering off;
      proxy_read_timeout 600s;
      proxy_send_timeout 600s;
      proxy_next_upstream off;
      proxy_pass http://files;
    }

    # Pictures and files for pages go straight to the file store too,
    # streamed, up to PAGE_FILES_MAX_MB (200 MB at most); the link is signed
    # by the API and works once. Showing one is a signed hour-long link.
    location /files/p/ {
      limit_req zone=per_client burst=20 nodelay;
      client_max_body_size 202m;
      proxy_request_buffering off;
      proxy_read_timeout 600s;
      proxy_send_timeout 600s;
      proxy_next_upstream off;
      proxy_pass http://files;
    }
    location /files/r/ {
      limit_req zone=per_client burst=100 nodelay;
      proxy_pass http://files;
    }

    # The MCP address for older setups (the web app's /api/mcp): the mcp
    # service, as on mcp.orbyn.dev.
    location = /mcp {
      ${MCP_GATE}
      # add_file sends a file of up to 25 MB as base64 (about 34 MB).
      client_max_body_size 36m;
      if ($mcp_listen) {
        rewrite ^ /.mcp-listen last;
      }
      limit_req zone=per_client burst=100 nodelay;
      limit_req zone=mcp_token burst=60 nodelay;
      limit_conn mcp_conn 8;
      proxy_buffering off;
      proxy_read_timeout 100s;
      proxy_next_upstream off;
      proxy_pass http://mcp;
      error_page 429 = @mcp_limited;
    }
    location @mcp_limited {
      add_header Retry-After 30 always;
      return 429 '{"jsonrpc":"2.0","id":null,"error":{"code":-32029,"message":"That\'s a lot at once. Wait a moment and try again."}}';
    }
    # An agent's listen stream: to realtime, unbuffered, kept open up to an
    # hour (the service closes it within 15 minutes and sends keep-alives).
    location = /.mcp-listen {
      internal;
      limit_req zone=mcp_token burst=10 nodelay;
      limit_conn mcp_conn 4;
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 1h;
      proxy_next_upstream off;
      proxy_pass http://realtime/mcp;
      error_page 429 = @mcp_limited;
    }

    # Everything else: the planner API (direct API clients only).
    location / {
      limit_req zone=per_client burst=100 nodelay;
      proxy_pass http://api;
    }

    error_page 502 503 504 = @unavailable;
    location @unavailable {
      return 503 '{"message":"Orbyn is briefly unavailable. Please try again."}';
    }
    # Limited by the burst budget above (or a direct client's own limit): a
    # machine-readable 429, so the apps' backoff works as designed.
    error_page 429 = @limited;
    location @limited {
      add_header Retry-After 5 always;
      return 429 '{"message":"That\'s a lot at once. Wait a moment and try again."}';
    }
  }

  # The web port: the app's pages from the web copies, and /api through the
  # API server on 8080. Every limit a browser request meets is counted here,
  # exactly once: the pass-through to 8080 adds none (the zones go empty for
  # what this server marks X-Orbyn-Via: web).
  server {
    listen 8081;
    client_max_body_size 64k;
    limit_conn conn_per_client 200;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Request-Id $request_id;
    proxy_connect_timeout 1s;
    proxy_read_timeout 125s;
    proxy_next_upstream error timeout http_502 http_503;
    proxy_next_upstream_tries 4;
    proxy_next_upstream_timeout 5s;

    location = /health {
      access_log off;
      return 200 '{"status":"ok","service":"gateway"}';
    }

    location = /api/agent-channels/slack/callback {
      access_log off;
      error_log /dev/null crit;
      proxy_next_upstream off;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_set_header X-Forwarded-Prefix /api;
      proxy_set_header X-Orbyn-Via web;
      limit_req zone=per_client burst=100 nodelay;
      proxy_pass http://127.0.0.1:8080/agent-channels/slack/callback;
    }

    location = /api/agent-channels/teams/callback {
      access_log off;
      error_log /dev/null crit;
      proxy_next_upstream off;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_set_header X-Forwarded-Prefix /api;
      proxy_set_header X-Orbyn-Via web;
      limit_req zone=per_client burst=100 nodelay;
      proxy_pass http://127.0.0.1:8080/agent-channels/teams/callback;
    }

    location = /api/agent-channels/teams/activities {
      access_log off;
      error_log /dev/null crit;
      proxy_next_upstream off;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_set_header X-Forwarded-Prefix /api;
      proxy_set_header X-Orbyn-Via web;
      limit_req zone=per_client burst=100 nodelay;
      proxy_pass http://127.0.0.1:8080/agent-channels/teams/activities;
    }

    location = /api/agent-channels/slack/events {
      access_log off;
      error_log /dev/null crit;
      proxy_next_upstream off;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_set_header X-Forwarded-Prefix /api;
      proxy_set_header X-Orbyn-Via web;
      limit_req zone=per_client burst=100 nodelay;
      proxy_pass http://127.0.0.1:8080/agent-channels/slack/events;
    }

    location = /api/agent-channels/slack/interactions {
      access_log off;
      error_log /dev/null crit;
      proxy_next_upstream off;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_set_header X-Forwarded-Prefix /api;
      proxy_set_header X-Orbyn-Via web;
      limit_req zone=per_client burst=100 nodelay;
      proxy_pass http://127.0.0.1:8080/agent-channels/slack/interactions;
    }

    location /api/ {
      # A proxy_set_header here replaces the server's, so all are restated.
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      # Links the API builds (the calendar feed) need the /api it sits under.
      proxy_set_header X-Forwarded-Prefix /api;
      # Mark this as already counted: the API server's zones go empty for
      # this header, so the burst budget below applies exactly once. (The
      # exact /api/imports/pages and /api/files/* locations below keep the
      # old behaviour — counted at the API server, as before.)
      proxy_set_header X-Orbyn-Via web;
      # Same burst budget as the API server's own catch-all, so direct and
      # browser clients are treated alike (counted once, here).
      limit_req zone=per_client burst=100 nodelay;
      proxy_pass http://127.0.0.1:8080/;
    }

    # Event streams the browser reaches at /api/events and
    # /api/events/docs/<id>: one per-address ceiling (see sse_per_client),
    # counted here and nowhere else. These must be regex locations ahead of
    # /api/ — but a regex location's proxy_pass may not carry a URI, so the
    # /api prefix is rewritten off instead. (The doc-live stream is counted
    # on the API server: it needs the X-Forwarded-Prefix /api header, and
    # its per-address budget is measured with the request streams'.)
    location ~ ^/api/events(?:/docs/[^/]+)?$ {
      limit_conn sse_per_client 100;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_set_header X-Orbyn-Via web;
      proxy_buffering off;
      proxy_read_timeout 1h;
      rewrite ^/api(/events.*)$ $1 break;
      proxy_pass http://127.0.0.1:8080;
    }
    location ~ ^/api/docs/[^/]+/live$ {
      limit_conn sse_per_client 100;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_set_header X-Orbyn-Via web;
      proxy_buffering off;
      proxy_read_timeout 1h;
      rewrite ^/api(/docs/[^/]+/live)$ $1 break;
      proxy_pass http://127.0.0.1:8080;
    }

    location = /api/imports/pages {
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      client_max_body_size 28m;
      proxy_pass http://127.0.0.1:8080/imports/pages;
    }

    # Published pages (SHR-05): read at /p/<slug> on the web app's own
    # address, written by the API as plain HTML (no app, no script).
    location ^~ /p/ {
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_pass http://127.0.0.1:8080/p/;
    }

    # Uploads for importing, through this gateway's own entry point above.
    location /api/files/u/ {
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      client_max_body_size 52m;
      proxy_request_buffering off;
      proxy_read_timeout 600s;
      proxy_send_timeout 600s;
      proxy_pass http://127.0.0.1:8080/files/u/;
    }

    # Pictures and files in pages, through this gateway's entry point above.
    location /api/files/p/ {
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      client_max_body_size 202m;
      proxy_request_buffering off;
      proxy_read_timeout 600s;
      proxy_send_timeout 600s;
      proxy_pass http://127.0.0.1:8080/files/p/;
    }
    location /api/files/r/ {
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_pass http://127.0.0.1:8080/files/r/;
    }

    # CalDAV, served by the API at its own /dav path (no /api strip), so Apple
    # Calendar, Thunderbird and DAVx5 can subscribe and write events back.
    location /dav/ {
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_pass http://127.0.0.1:8080;
    }
    location = /.well-known/caldav {
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_pass http://127.0.0.1:8080;
    }
    # Signing in with Orbyn: the authorization server's metadata (RFC 8414)
    # lives at the issuer (this host), served by the API. Its other endpoints
    # are under /api/oauth/ (the /api/ location above).
    location = /.well-known/oauth-authorization-server {
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_pass http://127.0.0.1:8080;
    }
    # The OpenAI apps directory's domain check, answered by the mcp service.
    location = /.well-known/openai-apps-challenge {
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_pass http://mcp;
    }
    # Where to report a security problem (RFC 9116), from the API.
    location = /.well-known/security.txt {
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_pass http://127.0.0.1:8080;
    }
    # Opening the web app's links in the phone app: the association files
    # iOS and Android check, built by the API from its environment.
    location = /.well-known/apple-app-site-association {
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_pass http://127.0.0.1:8080;
    }
    location = /.well-known/assetlinks.json {
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Request-Id $request_id;
      proxy_pass http://127.0.0.1:8080;
    }
    # Any other well-known document isn't here: a 404, not the web app's page
    # (clients probe paths like /.well-known/openid-configuration).
    location ^~ /.well-known/ {
      default_type application/json;
      return 404 '{"message":"That isn\'t here."}';
    }

    location / {
      proxy_pass http://web;
    }

    error_page 502 503 504 = @unavailable;
    location @unavailable {
      return 503 '{"message":"Orbyn is briefly unavailable. Please try again."}';
    }
    # Limited by the /api/ burst budget above: a machine-readable 429, so
    # the apps' backoff works as designed.
    error_page 429 = @limited;
    location @limited {
      add_header Retry-After 5 always;
      return 429 '{"message":"That\'s a lot at once. Wait a moment and try again."}';
    }
  }

  # The MCP host (mcp.orbyn.dev through the tunnel): only the MCP address and
  # its protected-resource metadata; everything else is a 404.
  server {
    listen 8082;
    client_max_body_size 1m;
    limit_conn conn_per_client 200;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Request-Id $request_id;
    proxy_connect_timeout 1s;
    proxy_read_timeout 100s;
    proxy_next_upstream error timeout http_502 http_503;
    proxy_next_upstream_tries 4;
    proxy_next_upstream_timeout 5s;

    location = /health {
      access_log off;
      return 200 '{"status":"ok","service":"gateway"}';
    }

    location = /mcp {
      ${MCP_GATE}
      # add_file sends a file of up to 25 MB as base64 (about 34 MB).
      client_max_body_size 36m;
      if ($mcp_listen) {
        rewrite ^ /.mcp-listen last;
      }
      # A high ceiling per address; the real limits are per credential.
      # Review in phase A2: hosted agents (claude.ai, ChatGPT) share their
      # providers' egress addresses, so raise this for those ranges (or
      # exempt them through LIMIT_EXEMPT) before they connect.
      limit_req zone=per_client burst=200 nodelay;
      limit_req zone=mcp_token burst=60 nodelay;
      limit_conn mcp_conn 8;
      proxy_buffering off;
      proxy_next_upstream off;
      proxy_pass http://mcp;
      error_page 429 = @mcp_limited;
    }
    location = /.well-known/oauth-protected-resource {
      proxy_pass http://mcp;
    }
    location = /.well-known/oauth-protected-resource/mcp {
      proxy_pass http://mcp;
    }
    # The OpenAI apps directory's domain check (its token is OPENAI_APPS_CHALLENGE).
    location = /.well-known/openai-apps-challenge {
      proxy_pass http://mcp;
    }
    location = /.mcp-listen {
      internal;
      limit_req zone=mcp_token burst=10 nodelay;
      limit_conn mcp_conn 4;
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 1h;
      proxy_next_upstream off;
      proxy_pass http://realtime/mcp;
      error_page 429 = @mcp_limited;
    }
    location @mcp_limited {
      add_header Retry-After 30 always;
      return 429 '{"jsonrpc":"2.0","id":null,"error":{"code":-32029,"message":"That\'s a lot at once. Wait a moment and try again."}}';
    }
    location / {
      return 404 '{"message":"That isn\'t here. The MCP address is /mcp."}';
    }

    error_page 502 503 504 = @unavailable;
    location @unavailable {
      return 503 '{"jsonrpc":"2.0","id":null,"error":{"code":-32603,"message":"Orbyn is briefly unavailable. Please try again."}}';
    }
  }
}
