# Public browser/build settings only. Never put server secrets in VITE_* variables.
# Web uses the same-origin /api gateway when blank. Installed desktop builds
# must set a reachable absolute API URL (production: https://your-domain/api).
VITE_API_URL=
VITE_WEB_URL=http://localhost:8080
VITE_DEBUG_ERRORS=false
# Optional override; 0 disables the collaborative document editor.
# VITE_DOC_CRDT=1
# VITE_APP_VERSION=dev
# Dev proxy is read from the process environment, not this file:
# API_PROXY_URL=http://localhost:8008
